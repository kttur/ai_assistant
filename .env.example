ASSISTANT_CHANNEL=telegram
LLM_PROVIDER=mock
LLM_AVAILABLE_PROVIDERS=auto,mock,openai,anthropic,ollama
AI_ASSISTANT_MODEL_MANIFEST_PATH=context/model_manifest.json
AI_ASSISTANT_AUTO_ROUTER_LOCAL_PROVIDER=ollama
AI_ASSISTANT_AUTO_ROUTER_LOCAL_MODEL=qwen3:4b
AI_ASSISTANT_AUTO_ROUTER_CLOUD_PROVIDER=openai
AI_ASSISTANT_AUTO_ROUTER_CLOUD_MODEL=gpt-5-nano
AI_ASSISTANT_AUTO_ROUTER_TIMEOUT_SECONDS=20
AI_ASSISTANT_AUTO_ROUTER_LOW_CONFIDENCE_THRESHOLD=0.55
AI_ASSISTANT_AUTO_ROUTER_FAST_PATH_ENABLED=true
AI_ASSISTANT_AUTO_ROUTER_FAST_PATH_PROVIDER=ollama
AI_ASSISTANT_AUTO_ROUTER_FAST_PATH_MODEL=qwen3:8b
AI_ASSISTANT_LLM_HEALTH_BASE_COOLDOWN_SECONDS=30
AI_ASSISTANT_LLM_HEALTH_MAX_COOLDOWN_SECONDS=300
USER_SETTINGS_BACKEND=memory
PERMISSIONS_BACKEND=auto
ADMIN_TELEGRAM_ID=
DEFAULT_LOCALE=ru
AUDIO_OUTPUT_BACKEND=none
TERMINAL_SHELL=powershell
TERMINAL_TIMEOUT_SECONDS=60
AI_ASSISTANT_ACTIVE_SKILLS=
AI_ASSISTANT_SKILL_FACTORIES=
AI_ASSISTANT_LOG_LEVEL=INFO
AI_ASSISTANT_LOG_FORMAT=%(asctime)s | %(levelname)s | %(name)s | %(message)s

AI_ASSISTANT_REMOTE_ENABLED=false
AI_ASSISTANT_REMOTE_BACKEND=postgres
AI_ASSISTANT_REMOTE_SERVER_ID=default
AI_ASSISTANT_REMOTE_WS_HOST=0.0.0.0
AI_ASSISTANT_REMOTE_WS_PORT=8765
AI_ASSISTANT_REMOTE_WS_PATH=/ws/remote
AI_ASSISTANT_REMOTE_WS_PUBLIC_URL=
AI_ASSISTANT_REMOTE_TLS_CERT_PATH=
AI_ASSISTANT_REMOTE_TLS_KEY_PATH=
AI_ASSISTANT_REMOTE_LINK_CODE_TTL_SECONDS=300
AI_ASSISTANT_REMOTE_REQUEST_TIMEOUT_SECONDS=20
AI_ASSISTANT_REMOTE_PING_INTERVAL_SECONDS=20
AI_ASSISTANT_REMOTE_PING_TIMEOUT_SECONDS=20
CERTBOT_DOMAIN=
CERTBOT_EMAIL=

AI_ASSISTANT_REMOTE_CLIENT_SERVER_URL=
AI_ASSISTANT_REMOTE_CLIENT_NAME=
AI_ASSISTANT_REMOTE_CLIENT_PLATFORM=windows
AI_ASSISTANT_REMOTE_CLIENT_TOKEN_FILE=.ai_assistant_remote_client_token.json
AI_ASSISTANT_REMOTE_CLIENT_ACTIVE_SKILLS=
AI_ASSISTANT_REMOTE_CLIENT_SKILL_FACTORIES=
AI_ASSISTANT_REMOTE_CLIENT_RECONNECT_MIN_SECONDS=1
AI_ASSISTANT_REMOTE_CLIENT_RECONNECT_MAX_SECONDS=30
AI_ASSISTANT_REMOTE_CLIENT_PING_INTERVAL_SECONDS=20
AI_ASSISTANT_REMOTE_CLIENT_PING_TIMEOUT_SECONDS=20

TELEGRAM_BOT_TOKEN=put-your-telegram-token-here

POSTGRES_DSN=postgresql://postgres:postgres@localhost:5432/ai_assistant

VOICEMEETER_STRIP_INDEX=5
VOICEMEETER_BUS=A1
VOICEMEETER_OUTPUT_PARAM=
VOICEMEETER_REMOTE_DLL_PATH=

AI_ASSISTANT_OPENAI_API_KEY=
AI_ASSISTANT_OPENAI_BASE_URL=
AI_ASSISTANT_OPENAI_MODEL=gpt-5-mini
AI_ASSISTANT_OPENAI_AVAILABLE_MODELS=gpt-5-nano,gpt-5-mini,gpt-5.2

AI_ASSISTANT_ANTHROPIC_API_KEY=
AI_ASSISTANT_ANTHROPIC_BASE_URL=
AI_ASSISTANT_ANTHROPIC_MODEL=claude-haiku-4-5
AI_ASSISTANT_ANTHROPIC_MAX_TOKENS=4096
AI_ASSISTANT_ANTHROPIC_AVAILABLE_MODELS=claude-sonnet-4-6,claude-opus-4-6,claude-haiku-4-5

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral-small3.2:24b
OLLAMA_AVAILABLE_MODELS=qwen3:4b,mistral-small3.2:24b,qwen3:32b,puyangwang/medgemma-27b-it:q6
AI_ASSISTANT_OLLAMA_AUTH_HEADER_NAME=
AI_ASSISTANT_OLLAMA_AUTH_HEADER_VALUE=
AI_ASSISTANT_OLLAMA_EXTRA_HEADERS_JSON=
