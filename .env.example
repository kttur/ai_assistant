ASSISTANT_CHANNEL=telegram
LLM_PROVIDER=mock
LLM_AVAILABLE_PROVIDERS=mock,openai,anthropic,ollama
USER_SETTINGS_BACKEND=memory
PERMISSIONS_BACKEND=auto
ADMIN_TELEGRAM_ID=
DEFAULT_LOCALE=ru
AUDIO_OUTPUT_BACKEND=none
TERMINAL_SHELL=powershell
TERMINAL_TIMEOUT_SECONDS=60

TELEGRAM_BOT_TOKEN=put-your-telegram-token-here

POSTGRES_DSN=postgresql://postgres:postgres@localhost:5432/ai_assistant

VOICEMEETER_STRIP_INDEX=5
VOICEMEETER_BUS=A1
VOICEMEETER_OUTPUT_PARAM=
VOICEMEETER_REMOTE_DLL_PATH=

AI_ASSISTANT_OPENAI_API_KEY=
AI_ASSISTANT_OPENAI_BASE_URL=
