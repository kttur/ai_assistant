AI_ASSISTANT_OPENAI_AVAILABLE_MODELS=gpt-4.1-mini

AI_ASSISTANT_ANTHROPIC_API_KEY=
AI_ASSISTANT_ANTHROPIC_BASE_URL=
AI_ASSISTANT_ANTHROPIC_MODEL=claude-3-5-sonnet-latest
AI_ASSISTANT_ANTHROPIC_AVAILABLE_MODELS=claude-3-5-sonnet-latest

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_AVAILABLE_MODELS=llama3.1
